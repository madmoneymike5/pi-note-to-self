{
  "name": "pi-note-to-self-development",
  "version": "0.0.0",
  "private": true,
  "description": "Note to Self — private development package for the Pi extension (Feature Spec #1 foundation).",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test tests/entry.test.ts",
    "build": "tsc --noEmit && npm pack --dry-run",
    "smoke": "node scripts/smoke.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run smoke && python3 scripts/check_repository.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.19.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
